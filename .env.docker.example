# Compose settings, not application credentials. Copy to .env.docker.
# CI deploy.sh records immutable image tags in .env.images, overriding these.
BACKEND_IMAGE=cashaba-backend:local
MIGRATIONS_IMAGE=cashaba-backend:migrations-local
BACKEND_ENV_FILE=.env.production
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
TLS_CERT_DIR=./docker/tls
# external: use the existing DATABASE_URL. container: enable the pgvector service.
DATABASE_MODE=external
# Set only when DATABASE_MODE=container; URL credentials must be percent-encoded.
POSTGRES_DB=cashaba
POSTGRES_USER=cashaba
POSTGRES_PASSWORD=
