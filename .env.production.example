# Copy to .env.production on the backend server only. Never bake this into an image.
NODE_ENV=production
PORT=8000
DATABASE_URL=postgresql://username:password@database-host/cashaba?sslmode=verify-full
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
# Frontend is independently deployed. Use its exact origin, without a trailing slash.
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
# Optional parent domain shared by frontend and API, e.g. .cloomero.cloud.
# Leave blank when no shared parent domain is used.
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.6-flash
AI_ALLOWED_MODELS=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
AI_DAILY_TOKEN_CAP=250000
AI_INDEXING_DAILY_TOKEN_CAP=1000000
AI_LIVE_EVAL=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set the intended mode explicitly. Credentials are never copied from development.
BILLING_MODE=disabled
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ALLOW_LEGACY_SIGNATURE=false
RATE_LIMIT_STORE=postgres
TRUST_PROXY_HOPS=1
