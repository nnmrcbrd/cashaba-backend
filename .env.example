DATABASE_URL="postgresql://username:password@host/database?sslmode=verify-full"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Add this exact URI to the Google OAuth client's Authorized redirect URIs.
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
GEMINI_API_KEY="your-google-ai-studio-key"
GEMINI_MODEL="gemini-3.6-flash"
# Required in production for signup verification and password recovery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Use demo only for local/capstone testing. Production must use webhook.
# Use demo only in local capstone development. Production accepts disabled or paymongo.
BILLING_MODE="demo"
# Required only after PayMongo enables Subscriptions for the merchant account.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Integration tests use a disposable, isolated database/schema, never DATABASE_URL.
TEST_DATABASE_URL=""
# Local alternative: run tests in a random schema inside DATABASE_URL.
ALLOW_ISOLATED_SCHEMA_TESTS="false"
