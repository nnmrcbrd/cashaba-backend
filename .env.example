DATABASE_URL="postgresql://username:password@host/database?sslmode=verify-full"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
# The www, root and api HTTPS origins at casha-ba.online and the Capacitor
# Android origin https://localhost are always allowed.
# Optional additional trusted origins, comma-separated; FRONTEND_URL is also allowed.
CORS_ALLOWED_ORIGINS=""
# Optional production cookie sharing across frontend/API subdomains.
# Example: COOKIE_DOMAIN=".casha-ba.online". Leave blank for localhost or host-only cookies.
COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Add this exact URI to the Google OAuth client's Authorized redirect URIs.
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
GEMINI_API_KEY="your-google-ai-studio-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_VISION_MODEL="gemini-3.6-flash"
AI_ALLOWED_MODELS="gemini-3.5-flash-lite"
# Optional fallback must also appear in AI_ALLOWED_MODELS. No automatic Pro escalation.
GEMINI_FALLBACK_MODEL=""
AI_QUESTION_CHARS="2000"
AI_HISTORY_MESSAGES="6"
AI_HISTORY_MESSAGE_CHARS="1500"
AI_CONTEXT_CHARS="18000"
AI_REQUEST_CHARS="32000"
AI_OUTPUT_TOKENS="1200"
AI_DEADLINE_MS="25000"
# Client abort timeout; Gemini's service deadline is kept at least 10000 ms.
AI_ATTEMPT_TIMEOUT_MS="8000"
AI_MAX_ATTEMPTS="2"
# Conservative token upper bound shared across workers through RateLimitBucket.
AI_DAILY_TOKEN_CAP="250000"
# Lexical query-term coverage, not cosine confidence or vector distance.
AI_RETRIEVAL_THRESHOLD="0.25"
# Semantic knowledge retrieval uses Gemini Embedding 2 and PostgreSQL pgvector.
# Dimensions/profile are versioned in code; do not mix model vector spaces.
AI_RAG_MAX_DISTANCE="0.4"
# Separate conservative budget for admin/CLI public-knowledge indexing.
AI_INDEXING_DAILY_TOKEN_CAP="1000000"
# Live evaluation is opt-in and uses synthetic data; do not enable for ordinary tests.
AI_LIVE_EVAL="0"
AI_LIVE_EVAL_QUESTIONS="10"
AI_LIVE_EVAL_TOKEN_CAP="250000"
# Required in all environments for signup OTP verification and password recovery.
# Fill these using the sending email provider, then run npm run check:email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Hosted checkout for capstone testing; accepts only sk_test_ keys, never real payments.
# Other modes: demo (local activation), disabled, paymongo (live recurring subscriptions).
BILLING_MODE="paymongo_test"
# Required only after PayMongo enables Subscriptions for the merchant account.
PAYMONGO_SECRET_KEY=""
# Hosted test checkout verifies payment by retrieving the session on return.
# Webhook signing secret is required for live recurring subscriptions.
PAYMONGO_WEBHOOK_SECRET=""
# Integration tests use a disposable, isolated database/schema, never DATABASE_URL.
TEST_DATABASE_URL=""
# Integration tests require TEST_DATABASE_URL; application database fallback is disabled.

# Production always uses PostgreSQL counters; migrate before starting the backend.
# Set postgres in development only after applying the migration.
RATE_LIMIT_STORE="memory"
# Match your deployment proxy chain; 0 for direct exposure, commonly 1 behind a single proxy.
TRUST_PROXY_HOPS="1"
# Enable only if a captured genuine provider event uses bare-body HMAC signatures.
PAYMONGO_ALLOW_LEGACY_SIGNATURE="false"
