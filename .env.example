DATABASE_URL="postgresql://username:password@host/database?sslmode=verify-full"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Add this exact URI to the Google OAuth client's Authorized redirect URIs.
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
GEMINI_API_KEY="your-google-ai-studio-key"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VISION_MODEL="gemini-3.6-flash"
# Required in all environments for signup OTP verification and password recovery.
# Fill these using the sending email provider, then run npm run check:email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Hosted checkout for capstone testing; accepts only sk_test_ keys, never real payments.
# Other modes: demo (local activation), disabled, paymongo (live recurring subscriptions).
BILLING_MODE="paymongo_test"
# Required only after PayMongo enables Subscriptions for the merchant account.
PAYMONGO_SECRET_KEY=""
# Hosted test checkout verifies payment by retrieving the session on return.
# Webhook signing secret is required for live recurring subscriptions.
PAYMONGO_WEBHOOK_SECRET=""
# Integration tests use a disposable, isolated database/schema, never DATABASE_URL.
TEST_DATABASE_URL=""
# Integration tests require TEST_DATABASE_URL; application database fallback is disabled.

# Production always uses PostgreSQL counters; migrate before starting the backend.
# Set postgres in development only after applying the migration.
RATE_LIMIT_STORE="memory"
# Match your deployment proxy chain; 0 for direct exposure, commonly 1 behind a single proxy.
TRUST_PROXY_HOPS="1"
# Enable only if a captured genuine provider event uses bare-body HMAC signatures.
PAYMONGO_ALLOW_LEGACY_SIGNATURE="false"
